---
kind: ConfigMap
apiVersion: v1
metadata:
  name: cni-install-sh
  namespace: kube-system
data:
  install_cni.sh: |
    set -eu
    CNI_PLUGINS_VERSION=v1.4.0
    CNI_TGZ="cni-plugins-linux-amd64-${CNI_PLUGINS_VERSION}.tgz"
    CNI_URL="https://github.com/containernetworking/plugins/releases/download/${CNI_PLUGINS_VERSION}/${CNI_TGZ}"
    CNI_BIN_DIR=/host/opt/cni/bin
    MAX_ATTEMPTS=5

    mkdir -p "${CNI_BIN_DIR}"
    cd /tmp
    rm -f "${CNI_TGZ}"

    attempt=1
    while [ "${attempt}" -le "${MAX_ATTEMPTS}" ]; do
      echo "Downloading ${CNI_URL} (attempt ${attempt}/${MAX_ATTEMPTS})"
      if wget -O "${CNI_TGZ}" "${CNI_URL}"; then
        break
      fi
      echo "wget failed for ${CNI_URL}"
      rm -f "${CNI_TGZ}"
      if [ "${attempt}" -eq "${MAX_ATTEMPTS}" ]; then
        echo "error: failed to download CNI plugins after ${MAX_ATTEMPTS} attempts"
        exit 1
      fi
      attempt=$((attempt + 1))
      sleep $((attempt * 2))
    done

    tar xvfzp "/tmp/${CNI_TGZ}" -C "${CNI_BIN_DIR}"
    # Fail closed: pods must not become Ready without secondary-network plugins.
    for plugin in macvlan host-local static bridge loopback; do
      if [ ! -x "${CNI_BIN_DIR}/${plugin}" ]; then
        echo "error: expected executable ${CNI_BIN_DIR}/${plugin} after CNI plugin install"
        ls -la "${CNI_BIN_DIR}" || true
        exit 1
      fi
    done
    echo "CNI plugins installed successfully in ${CNI_BIN_DIR}"
    sleep infinite
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: install-cni-plugins
  namespace: kube-system
  labels:
    name: cni-plugins
spec:
  selector:
    matchLabels:
      name: cni-plugins
  template:
    metadata:
      labels:
        name: cni-plugins
    spec:
      hostNetwork: true
      nodeSelector:
        kubernetes.io/arch: amd64
      tolerations:
      - operator: Exists
        effect: NoSchedule
      containers:
      - name: install-cni-plugins
        image: docker.io/library/alpine
        command: ["/bin/sh", "/scripts/install_cni.sh"]
        resources:
          requests:
            cpu: "100m"
            memory: "50Mi"
          limits:
            cpu: "100m"
            memory: "50Mi"
        # Only Ready after plugins are on the host; kubectl wait in setup_cluster.sh
        # used to pass even when wget failed because the container still slept.
        readinessProbe:
          exec:
            command: ["test", "-x", "/host/opt/cni/bin/macvlan"]
          initialDelaySeconds: 2
          periodSeconds: 5
          failureThreshold: 24
        securityContext:
          privileged: true
        volumeMounts:
        - name: cni-bin
          mountPath: /host/opt/cni/bin
        - name: scripts
          mountPath: /scripts
      volumes:
        - name: cni-bin
          hostPath:
            path: /opt/cni/bin
        - name: scripts
          configMap:
            name: cni-install-sh
            items:
            - key: install_cni.sh
              path: install_cni.sh
